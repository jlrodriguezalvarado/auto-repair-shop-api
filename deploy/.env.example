# Copy to /opt/apps/mechanics/.env on the server. Never commit real secrets.
REGISTRY_HOST=registry.example.com
MECHANICS_HOST=mechanics.example.com
MECHANICS_API_HOST=mechanicsapi.example.com
PROXY_NETWORK=proxy

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars-xxxx
JWT_SIGNING_KEY=change-me-to-a-long-random-string-at-least-50-chars-yyyy
ALLOWED_HOSTS=mechanicsapi.example.com
CSRF_TRUSTED_ORIGINS=https://mechanicsapi.example.com
CORS_ALLOWED_ORIGINS=https://mechanics.example.com
SECURE_SSL_REDIRECT=1
REQUIREMENTS_FILE=production.txt
RUN_MIGRATIONS=0
RUN_COLLECTSTATIC=1

# Postgres (compose service: db)
POSTGRES_DB=mechanics_api
DB_USER=mechanics
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT_INTERNAL=5432
DB_WAIT_SECONDS=60

# Backups
# Default if unset: <script dir>/backups (created automatically)
# BACKUP_DIR=/opt/apps/mechanics/backups
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_MONTHLY=3

# Web Push (optional; PWA notifications — HTTPS required)
# Generate: vapid --gen && vapid --applicationServerKey -k private_key.pem
# On server: install -m 600 private_key.pem /opt/apps/mechanics/secrets/vapid_private.pem
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/run/secrets/vapid_private.pem
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Optional S3 for media/images/PDFs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2
AWS_S3_ENDPOINT_URL=
AWS_S3_KEY_PREFIX=production
