# Copy to .env and adjust values for your machine.
COMPOSE_PROJECT_NAME=auto-repair-shop-api
API_PORT=8000
POSTGRES_DB=taller
POSTGRES_USER=taller
POSTGRES_PASSWORD=taller
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local.test
PGADMIN_DEFAULT_PASSWORD=admin
RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=true
DB_WAIT_TIMEOUT=60
GUNICORN_WORKERS=2
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_TIMEOUT=120
