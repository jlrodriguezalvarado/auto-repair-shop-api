# Local Docker (optional). Copy to .env
APP_PORT=8001
DJANGO_SETTINGS_MODULE=config.settings.local
POSTGRES_DB=mechanics_api
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=tools_postgres
DB_PORT_INTERNAL=5432
DEBUG=1
SECRET_KEY=django-insecure-local-mechanics-change-me
JWT_SIGNING_KEY=django-insecure-local-mechanics-change-me
CORS_ALLOW_ALL_ORIGINS=1
REQUIREMENTS_FILE=local.txt
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
# DOCKER_TOOLS_DIR=/home/jlrodriguez/projects/docker-tools

# Web Push (optional for local PWA testing over HTTPS/localhost)
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=private_key.pem
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# AWS S3 (optional — media/images/PDFs; local FileSystemStorage when unset)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_KEY_PREFIX=local
